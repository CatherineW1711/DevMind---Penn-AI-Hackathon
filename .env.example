# Copy this file to .env and fill in your API key

# Anthropic Claude API (recommended)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OR OpenAI API (set LLM_PROVIDER=openai to use this)
OPENAI_API_KEY=your_openai_api_key_here

# Which LLM provider to use: "anthropic" or "openai" (default: anthropic)
LLM_PROVIDER=anthropic

# Set to true to run demo without any API key (uses pre-built responses)
MOCK_LLM=true

# Server port (default: 3001)
PORT=3001
